{
  "name": "ai-agent-mvp",
  "version": "2.0.0",
  "description": "基于 Fastify + OpenAI 的 AI Agent 服务，支持 ReAct 循环、Tool 调用、SSE 流式输出，对接 Qwen / DeepSeek 模型",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "redis_dev": "SESSION_DRIVER=redis REDIS_URL=redis://localhost:6379 pnpm dev",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "tsx src/index.ts & tsx test/wait-ready.ts && tsx test.ts; kill %1 2>/dev/null",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "lint": "eslint src/ test.ts",
    "lint:fix": "eslint src/ test.ts --fix",
    "format": "prettier --write src/ test.ts public/",
    "format:check": "prettier --check src/ test.ts public/",
    "prepare": "husky",
    "commitlint": "commitlint",
    "changelog": "node scripts/changelog.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^9.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^16.0.0",
    "fastify": "^4.0.0",
    "ioredis": "^5.11.1",
    "node-cache": "^5.1.2",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.5.2",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "husky": "9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^2.1.9"
  }
}