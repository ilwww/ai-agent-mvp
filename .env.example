# DashScope（必填）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型与接口
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen3-235b-a22b
DEEPSEEK_MODEL=deepseek-v3.2

# 服务
PORT=3131
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
REQUEST_TIMEOUT=30000

# 存储驱动：memory | redis（任一为 redis 时必须提供 REDIS_URL）
CACHE_DRIVER=memory
SESSION_DRIVER=memory
# REDIS_URL=redis://localhost:6379

# 会话
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=20

# LLM 重试
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=500

# MCP：JSON 数组，支持 stdio 与 http 两种 transport
# MCP_SERVERS=[{"name":"fs","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"],"denyTools":["write_file"]}]
# MCP_SERVERS=[{"name":"remote","transport":"http","url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer xxx"}}]
MCP_CALL_TIMEOUT_MS=30000
MCP_RESULT_MAX_CHARS=8000
